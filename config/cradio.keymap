#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    conditional_layers { compatible = "zmk,conditional-layers"; };

    combos {
        compatible = "zmk,combos";

        l-shift {
            bindings = <&kp LSHIFT>;
            key-positions = <12 13>;
            slow-release;
            timeout-ms = <35>;
            require-prior-idle-ms = <120>;
        };

        r-shift {
            bindings = <&kp RSHIFT>;
            key-positions = <16 17>;
            timeout-ms = <35>;
            require-prior-idle-ms = <120>;
            slow-release;
        };

        l-ctrl-shift-alt {
            bindings = <&kp LS(LC(LEFT_ALT))>;
            key-positions = <20 23>;
            timeout-ms = <35>;
            slow-release;
            require-prior-idle-ms = <120>;
        };
    };

    behaviors {
        l_hrm: l_hrm {
            compatible = "zmk,behavior-hold-tap";
            label = "L_HRM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 32 33>;
        };

        r_hrm: r_hrm {
            compatible = "zmk,behavior-hold-tap";
            label = "R_HRM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q              &kp W              &kp E           &kp R        &kp T        &kp Y            &kp U        &kp I               &kp O               &kp P
&l_hrm A LEFT_WIN  &l_hrm S LEFT_ALT  &l_hrm D LCTRL  &kp F        &kp G        &kp H            &kp J        &r_hrm K LC(RCTRL)  &r_hrm L RIGHT_ALT  &r_hrm SEMI RWIN
&kp Z              &kp X              &kp C           &kp V        &kp B        &kp N            &kp M        &kp COMMA           &kp DOT             &kp FSLH
                                                      &lt 1 ENTER  &lt 2 TAB    &lt 4 BACKSPACE  &lt 3 SPACE
            >;
        };

        nav_layer {
            bindings = <
&kp RC(NUMBER_1)  &kp LC(LS(TAB))  &kp LC(TAB)  &kp RC(N9)      &kp LA(G)            &trans    &kp HOME              &kp PAGE_DOWN  &kp PG_UP  &kp END
&kp LEFT_WIN      &kp LEFT_ALT     &kp LCTRL    &kp LEFT_SHIFT  &kp LA(GRAVE)        &kp LEFT  &kp DOWN              &kp UP         &kp RIGHT  &kp ESCAPE
&kp LC(LG(LEFT))  &kp LC(X)        &kp LC(C)    &kp LC(LS(V))   &kp LG(LC(RIGHT))    &trans    &kp LS(LC(NUMBER_1))  &kp LS(SLASH)  &kp SLASH  &kp LS(N7)
                                                &trans          &trans               &kp DEL   &kp LS(LC(NUMBER_2))
            >;
        };

        num_pad {
            bindings = <
&trans        &trans    &trans     &trans     &trans    &kp SLASH     &kp N7  &kp N8  &kp N9  &kp MINUS
&kp LEFT_WIN  &kp LALT  &kp LCTRL  &kp LSHFT  &trans    &kp ASTERISK  &kp N4  &kp N5  &kp N6  &kp PLUS
&trans        &trans    &trans     &trans     &trans    &kp DOT       &kp N1  &kp N2  &kp N3  &kp EQUAL
                                   &trans     &trans    &kp ESCAPE    &kp N0
            >;
        };

        sym_layer {
            bindings = <
&kp GRAVE  &trans         &trans        &trans    &trans       &trans  &kp LEFT_BRACE        &kp RIGHT_BRACE        &trans   &kp NON_US_BACKSLASH
&kp EXCL   &kp AT         &kp HASH      &kp DLLR  &kp PRCNT    &trans  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp SQT  &kp DOUBLE_QUOTES
&kp CARET  &kp AMPERSAND  &kp ASTERISK  &trans    &trans       &trans  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &trans   &trans
                                        &trans    &trans       &trans  &trans
            >;
        };

        func_layer {
            bindings = <
&trans  &trans      &trans                    &trans                &trans    &trans  &trans  &trans  &trans  &trans
&trans  &kp F2      &kp LC(C_BRIGHTNESS_DEC)  &kp C_BRIGHTNESS_INC  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &kp C_MUTE  &kp C_VOLUME_DOWN         &kp C_VOLUME_UP       &trans    &trans  &trans  &trans  &trans  &trans
                                              &trans                &trans    &trans  &trans
            >;
        };
    };
};

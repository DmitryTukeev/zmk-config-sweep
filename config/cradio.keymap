#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        HT: Hold_Tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <350>;
            bindings = <&kp>, <&kp>;
        };

        HRM_Shift_L: HRM_Shift_L {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;

            label = "HRM_Shift_L";
            hold-while-undecided;
            hold-trigger-on-release;
            hold-trigger-key-positions = <15 16 17 18 19 25 26 27 28 29 15 16 17 18 19 25 26 27 28 29 5 6 7 15 16 17 25 26 27 32 33 7 8 9>;
        };

        HRM_Shift_R: HRM_Shift_R {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;

            label = "HRM_SHIFT_R";
            hold-while-undecided;
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31>;
        };

        HRM_L: HRM_L {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;

            label = "HRM_L";
            hold-while-undecided;
            hold-trigger-on-release;
            hold-trigger-key-positions = <15 16 17 18 19 25 26 27 28 29 15 16 17 18 19 25 26 27 28 29 5 6 7 15 16 17 25 26 27 32 33 7 8 9>;
        };

        HRM_R: HRM_R {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;

            label = "HRM_R";
            hold-while-undecided;
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31>;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q          &kp W          &kp E           &kp R                 &kp T        &kp Y       &kp U                 &kp I           &kp O          &kp P
&HRM_L LGUI A  &HRM_L LALT S  &HRM_L LCTRL D  &HRM_Shift_L LSHFT F  &kp G        &kp H       &HRM_Shift_R RSHFT J  &HRM_R RCTRL K  &HRM_R RALT L  &HRM_R RGUI SEMICOLON
&kp Z          &kp X          &kp C           &kp V                 &kp B        &kp N       &kp M                 &kp COMMA       &kp DOT        &kp FSLH
                                              &lt 1 TAB             &kp ENTER    &kp ESCAPE  &kp SPACE
            >;
        };

        nav_layer {
            bindings = <
&kp RC(NUMBER_1)   &kp LC(LS(TAB))    &kp LC(TAB)     &kp RC(N9)                 &kp LA(G)            &trans    &kp HOME              &kp PAGE_DOWN         &kp PG_UP  &kp END
&HRM_L LEFT_WIN A  &HRM_L LEFT_ALT S  &HRM_L LCTRL D  &HRM_Shift_L LEFT_SHIFT F  &trans               &kp LEFT  &kp DOWN              &kp UP                &kp RIGHT  &trans
&kp LC(LG(LEFT))   &kp LA(GRAVE)      &kp DEL         &kp BACKSPACE              &kp LG(LC(RIGHT))    &trans    &kp LS(LC(NUMBER_1))  &kp LS(LC(NUMBER_2))  &trans     &trans
                                                      &trans                     &trans               &trans    &trans
            >;
        };

        num_pad {
            bindings = <
&none  &none  &none  &none  &none    &none  &none  &none  &none  &none
&none  &none  &none  &none  &none    &none  &none  &none  &none  &none
&none  &none  &none  &none  &none    &none  &none  &none  &none  &none
                     &none  &none    &none  &none
            >;
        };

        left_layer {
            bindings = <
&trans    &kp LBKT  &kp LBRC  &kp RBRC  &trans       &kp CARET  &kp LPAR   &kp RPAR   &kp RBKT  &kp TILDE
&kp EXCL  &kp AT    &kp HASH  &kp DLLR  &kp PRCNT    &kp ASTRK  &kp MINUS  &kp EQUAL  &kp BSLH  &kp GRAVE
&trans    &trans    &trans    &trans    &trans       &kp AMPS   &kp UNDER  &kp PLUS   &kp PIPE  &trans
                              &trans    &trans       &trans     &trans
            >;
        };
    };
};

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        HRM_Shift_L: HRM_Shift_L {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;

            label = "HRM_Shift_L";
            hold-while-undecided;
            hold-trigger-on-release;
            hold-trigger-key-positions = <15 16 17 18 19 25 26 27 28 29 15 16 17 18 19 25 26 27 28 29 5 6 7 15 16 17 25 26 27 32 33 7 8 9>;
        };

        HRM_Shift_R: HRM_Shift_R {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;

            label = "HRM_SHIFT_R";
            hold-while-undecided;
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31>;
        };

        HRM_L: HRM_L {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;

            label = "HRM_L";
            hold-while-undecided;
            hold-trigger-on-release;
            hold-trigger-key-positions = <15 16 17 18 19 25 26 27 28 29 15 16 17 18 19 25 26 27 28 29 5 6 7 15 16 17 25 26 27 32 33 7 8 9>;
        };

        HRM_R: HRM_R {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;

            label = "HRM_R";
            hold-while-undecided;
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31>;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };

    combos {
        compatible = "zmk,combos";

        mouse {
            bindings = <&tog 5>;
            key-positions = <22 23>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q          &kp W          &kp E           &kp R                 &kp T          &kp Y            &kp U                 &kp I           &kp O          &kp P
&HRM_L LGUI A  &HRM_L LALT S  &HRM_L LCTRL D  &HRM_Shift_L LSHFT F  &kp G          &kp H            &HRM_Shift_R RSHFT J  &HRM_R RCTRL K  &HRM_R RALT L  &HRM_R RGUI SEMICOLON
&kp Z          &kp X          &kp C           &kp V                 &kp B          &kp N            &kp M                 &kp COMMA       &kp DOT        &kp FSLH
                                              &lt 1 TAB             &lt 2 ENTER    &lt 4 BACKSPACE  &lt 3 SPACE
            >;
        };

        nav_layer {
            bindings = <
&kp RC(NUMBER_1)  &kp LC(LS(TAB))  &kp LC(TAB)  &kp RC(N9)      &kp LA(G)            &trans    &kp HOME              &kp PAGE_DOWN  &kp PG_UP   &kp END
&kp LEFT_WIN      &kp LEFT_ALT     &kp LCTRL    &kp LEFT_SHIFT  &kp LA(GRAVE)        &kp LEFT  &kp DOWN              &kp UP         &kp RIGHT   &kp ESCAPE
&kp LC(LG(LEFT))  &kp LC(X)        &kp LC(C)    &kp LC(LS(V))   &kp LG(LC(RIGHT))    &trans    &kp LS(LC(NUMBER_1))  &kp COMMA      &kp PERIOD  &kp QUESTION
                                                &trans          &trans               &kp DEL   &kp LS(LC(NUMBER_2))
            >;
        };

        num_pad {
            bindings = <
&trans        &trans    &trans     &trans     &trans    &kp SLASH     &kp N7  &kp N8  &kp N9  &kp MINUS
&kp LEFT_WIN  &kp LALT  &kp LCTRL  &kp LSHFT  &trans    &kp ASTERISK  &kp N4  &kp N5  &kp N6  &kp PLUS
&trans        &trans    &trans     &trans     &trans    &kp DOT       &kp N1  &kp N2  &kp N3  &kp EQUAL
                                   &trans     &trans    &kp ESCAPE    &kp N0
            >;
        };

        sym_layer {
            bindings = <
&kp GRAVE  &trans         &trans        &trans    &trans       &trans  &kp LEFT_BRACE        &kp RIGHT_BRACE        &trans   &kp NON_US_BACKSLASH
&kp EXCL   &kp AT         &kp HASH      &kp DLLR  &kp PRCNT    &trans  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp SQT  &kp DOUBLE_QUOTES
&kp CARET  &kp AMPERSAND  &kp ASTERISK  &trans    &trans       &trans  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &trans   &trans
                                        &trans    &trans       &trans  &trans
            >;
        };

        func_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &kp F2  &kp F3  &kp F4  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &kp F5  &kp F6  &kp F7  &trans    &trans  &trans  &trans  &trans  &trans
                        &trans  &trans    &trans  &trans
            >;
        };

        mouse {
            bindings = <
&trans  &trans          &trans          &trans           &trans    &trans  &trans          &mkp MB4        &mkp MB5         &trans
&trans  &msc SCRL_LEFT  &msc SCRL_UP    &msc SCRL_RIGHT  &trans    &trans  &mmv MOVE_LEFT  &mmv MOVE_UP    &mmv MOVE_RIGHT  &trans
&trans  &mkp LCLK       &msc SCRL_DOWN  &mkp RCLK        &trans    &trans  &mkp LCLK       &mmv MOVE_DOWN  &mkp RCLK        &trans
                                        &mkp MCLK        &trans    &trans  &trans
            >;
        };
    };
};
